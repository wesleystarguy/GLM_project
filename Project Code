#-----------------------------------------------------------------
# Forward stepwise selection (Poisson GLM for frequency) using AIC
#-----------------------------------------------------------------
train_sel_freq = train_freq.copy()
train_sel_freq = train_sel_freq.rename(columns=lambda c: c.replace('.', '_').replace('-', '_'))

response_freq = 'num_claims'
candidates_freq = ['age_cat', 'gender', 'area_f', 'veh_make_f', 'veh_age', 'veh_value','veh_body']

reference_levels_freq = {
    'gender': 'F',
    'area_f': 'ABC',
    'veh_make_f': 'CD',
    'veh_age': '34',
    'veh_body': 'B'
}

for c in ['gender', 'area_f', 'veh_age', 'veh_body','veh_make_f']:
    if c in train_sel_freq.columns:
        train_sel_freq[c] = train_sel_freq[c].astype('category')
        ref = reference_levels_freq.get(c)
        if ref is not None and ref in train_sel_freq[c].cat.categories:
            cats = [ref] + [x for x in train_sel_freq[c].cat.categories if x != ref]
            train_sel_freq[c] = pd.Categorical(train_sel_freq[c], categories=cats, ordered=False)

def _cat_term_freq(cand, df):
    if str(df[cand].dtype) == 'category':
        return f'C({cand})'
    return cand

current_features_freq = []
df_train_fs_freq = train_sel_freq

model_freq = smf.glm(
    formula=f'{response_freq} ~ 1',
    data=df_train_fs_freq,
    family=sm.families.Poisson(sm.families.links.Log()),
    offset=np.log(df_train_fs_freq['exposure'])
).fit()

best_aic_freq = model_freq.aic
remaining_freq = candidates_freq.copy()
improved_freq = True

while improved_freq and remaining_freq:
    improved_freq = False
    best_candidate_freq = None
    best_candidate_aic_freq = best_aic_freq
    for cand in remaining_freq:
        term = _cat_term_freq(cand, train_sel_freq)
        formula_freq = (
            f'{response_freq} ~ {" + ".join(current_features_freq + [term])}'
            if current_features_freq
            else f'{response_freq} ~ {term}'
        )
        try:
            fm_freq = smf.glm(
                formula=formula_freq,
                data=df_train_fs_freq,
                family=sm.families.Poisson(sm.families.links.Log()),
                offset=np.log(df_train_fs_freq['exposure'])
            ).fit()
            if fm_freq.aic < best_candidate_aic_freq:
                best_candidate_aic_freq = fm_freq.aic
                best_candidate_freq = cand
                best_candidate_model_freq = fm_freq
        except Exception:
            continue

    if best_candidate_freq is not None and best_candidate_aic_freq < best_aic_freq:
        current_features_freq.append(_cat_term_freq(best_candidate_freq, train_sel_freq))
        remaining_freq.remove(best_candidate_freq)
        best_aic_freq = best_candidate_aic_freq
        final_model_freq = best_candidate_model_freq
        improved_freq = True

print('Selected formula:', f'{response_freq} ~ {" + ".join(current_features_freq) if current_features_freq else "1"}')
print('AIC:', best_aic_freq)
print(final_model_freq.summary())

#--------------------------------------------------------------
# Forward stepwise selection (Gamma GLM for severity) using AIC
#--------------------------------------------------------------

train_sel_sev = train_sev.copy()
train_sel_sev = train_sel_sev.rename(columns=lambda c: c.replace('.', '_').replace('-', '_'))

# response, candidates
response_sev = 'severity'
candidates_sev = ['age_cat','gender','area_s','veh_body','veh_make_s','veh_age_s','veh_value']

# selected base levels for categorical predictors
reference_levels_sev = {

    'gender': 'F',
    'area_s': 'Other',
    'veh_make_s': 'CD',
    'veh_body': 'SEDAN',
    'veh_age_s': '34'
}

# ensure categorical dtype for nominal predictors and fix reference level order
for c in ['gender', 'area_s', 'veh_age_s','veh_body','veh_make_s']:
    if c in train_sel_sev.columns:
        train_sel_sev[c] = train_sel_sev[c].astype('category')
        ref = reference_levels_sev.get(c)
        if ref is not None and ref in train_sel_sev[c].cat.categories:
            cats = [ref] + [x for x in train_sel_sev[c].cat.categories if x != ref]
            train_sel_sev[c] = pd.Categorical(train_sel_sev[c], categories=cats, ordered=False)


# helper to build categorical terms for forward selection
def _cat_term_sev(cand, df):
    if str(df[cand].dtype) == 'category':
        return f'C({cand})'
    return cand


# forward stepwise by AIC
current_features_sev = []
best_aic_sev = None
df_train_fs_sev = train_sel_sev

# fit intercept-only model
model_sev = smf.glm(formula=f'{response_sev} ~ 1', data=df_train_fs_sev,
                family=sm.families.Gamma(sm.families.links.Log())).fit()
best_aic_sev = model_sev.aic

remaining_sev = candidates_sev.copy()
improved_sev = True

while improved_sev and remaining_sev:
    improved_sev = False
    best_candidate_sev = None
    best_candidate_aic_sev = best_aic_sev
    for cand in remaining_sev:
        term = _cat_term_sev(cand, train_sel_sev)
        formula_sev = f'{response_sev} ~ {" + ".join(current_features_sev + [term])}' if current_features_sev else f'{response_sev} ~ {term}'
        try:
            fm_sev = smf.glm(
                formula=formula_sev,
                data=df_train_fs_sev,
                family=sm.families.Gamma(sm.families.links.Log())
            ).fit()
            if fm_sev.aic < best_candidate_aic_sev:
                best_candidate_aic_sev = fm_sev.aic
                best_candidate_sev = cand
                best_candidate_model_sev = fm_sev
        except Exception:
            continue

    if best_candidate_sev is not None and best_candidate_aic_sev < best_aic_sev:
        term = _cat_term_sev(best_candidate_sev, train_sel_sev)
        current_features_sev.append(term)
        remaining_sev.remove(best_candidate_sev)
        best_aic_sev = best_candidate_aic_sev
        final_model_sev = best_candidate_model_sev
        improved_sev = True

print('Selected formula:', f'{response_sev} ~ {" + ".join(current_features_sev) if current_features_sev else "1"}')
print('AIC:', best_aic_sev)
print(final_model_sev.summary())


#---------------------------------------
# frequency Coefficient plot with 95% CI (not in report)
#---------------------------------------

coef = final_model_freq.params.copy()
ci = final_model_freq.conf_int(alpha=0.05).copy()
coef_df = pd.DataFrame({
    'term': coef.index,
    'coef': coef.values,
    'ci_low': ci[0].values,
    'ci_high': ci[1].values
}).reset_index(drop=True)

# drop intercept
coef_df = coef_df[~coef_df['term'].str.contains('Intercept', regex=False)].reset_index(drop=True)

# detect categorical terms from statsmodels naming (e.g. C(var)[T.level])
def parse_cat(term):
    # returns (var, level) or (None, None)
    if 'C(' in term and ']' in term:
        # form: C(var)[T.level] or C(var)[T.level]:something
        var = term.split('C(')[1].split(')')[0]
        level = term.split(']')[0].split('[')[1].replace('T.', '')
        return var, level
    return None, None

# compute counts for categorical levels
counts = []
for t in coef_df['term']:
    var, level = parse_cat(t)
    if var is not None:
        cnt = int(train_sel_freq[var].eq(level).sum())
    else:
        cnt = 0
    counts.append(cnt)
coef_df['count'] = counts

# ordering for display
coef_df = coef_df.sort_values('coef').reset_index(drop=True)
y = np.arange(len(coef_df))

# scale counts into a background width range
xmin = coef_df['ci_low'].min()
xmax = coef_df['ci_high'].max()
width_range = xmax - xmin if xmax > xmin else 1.0
max_count = coef_df['count'].max() if coef_df['count'].max() > 0 else 1
scale_factor = (width_range * 0.6) / max_count

fig, ax = plt.subplots(figsize=(8, max(4, len(coef_df)*0.4)))

# draw background bars for categorical levels
for i, row in coef_df.iterrows():
    if row['count'] > 0:
        bar_left = xmin + width_range * 0.05
        bar_width = row['count'] * scale_factor
        ax.barh(y[i], bar_width, left=bar_left, color='grey', alpha=0.25)
        ax.text(bar_left + bar_width + width_range*0.02, y[i], str(row['count']),
                va='center', fontsize=8, color='grey')

# plot coefficients with 95% CI whiskers
ax.errorbar(coef_df['coef'], y, xerr=[coef_df['coef'] - coef_df['ci_low'], coef_df['ci_high'] - coef_df['coef']],
            fmt='o', color='C1', capsize=4, lw=1.5)

ax.set_yticks(y)
ax.set_yticklabels(coef_df['term'])
ax.axvline(0, color='k', linestyle='--', linewidth=0.8)
ax.set_xlabel('Coefficient estimate (log link scale)')
ax.set_title('Frequency Model Coefficients with 95% CI')
plt.tight_layout()
plt.show()

