plt.plot([0, 1], [0, 1], color='red', linestyle='--', label='Line of equality')
plt.fill_between(lorenz_x, lorenz_y, lorenz_x, where=(lorenz_y < lorenz_x), color='lightblue', alpha=0.3)
plt.title('Lorenz Curve for Frequency Model (Gini Coef. = 0.3215)')
