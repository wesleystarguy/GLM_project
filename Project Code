df_lorenz['cum_claims_pct'] = df_lorenz['num_claims'].cumsum() / total_claims

lorenz_x = np.concatenate([[0.0], df_lorenz['cum_population'].values])
lorenz_y = np.concatenate([[0.0], df_lorenz['cum_claims_pct'].values])

gini_area = np.sum((lorenz_x[1:] - lorenz_x[:-1]) * (lorenz_y[1:] + lorenz_y[:-1]) / 2)
gini_coef = 1 - 2 * gini_area

