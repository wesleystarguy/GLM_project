formula = 'severity ~ age_cat + C(area_s) + C(veh_make_s) + C(veh_age_s)'
df_valid_sev = train_sev.copy()

cat_levels = {
    'veh_make_s': ['CD', 'AB'],
    'area_s': ['Other', 'A'],
