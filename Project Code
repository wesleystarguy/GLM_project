}

for col, cats in cat_levels.items():
    df_valid_sev[col] = pd.Categorical(df_valid_sev[col], categories=cats, ordered=False)

for i in range(1, 11):
    df_train = train_sev[train_sev['fold'] != i].copy()
    for col, cats in cat_levels.items():
        df_train[col] = pd.Categorical(df_train[col], categories=cats, ordered=False)

    model_sev = smf.glm(
        formula=formula,
        data=df_train,
        family=sm.families.Gamma(sm.families.links.Log()),
    ).fit()

    mask = df_valid_sev['fold'] == i
